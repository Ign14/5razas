{
  "name": "5razas",
  "private": true,
  "version": "0.0.1",
  "description": "5RAZAS — RPG isométrico en pixel art (vertical slice 0.1.0 en desarrollo)",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "gen:map": "node --experimental-strip-types --no-warnings scripts/generate-map.ts",
    "analyze:map": "node --experimental-strip-types --no-warnings scripts/analyze-map.ts",
    "check": "npm run typecheck && npm run lint && npm run test"
  },
  "dependencies": {
    "phaser": "3.90.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.19.2",
    "eslint": "^10.14.0",
    "globals": "^17.13.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
